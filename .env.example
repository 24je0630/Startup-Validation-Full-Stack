# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/startup_validation?schema=public"

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Public app URL, used for links in emails etc. (added in later phases)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
