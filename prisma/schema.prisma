// Prisma schema for the Startup Validation Platform.
// This file grows with each phase — Phase 1 only defines the base User model
// so the migration pipeline is provable end-to-end before we layer on features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
