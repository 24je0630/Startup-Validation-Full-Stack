// Prisma schema for the Startup Validation Platform.
// This file grows with each phase — Phase 1 only defines the base User model
// so the migration pipeline is provable end-to-end before we layer on features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // bcrypt hash — never store or return plaintext
  credits   Int      @default(1000) // starting virtual investment balance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ideas       Idea[]
  votes       Vote[]
  investments Investment[]
  comments    Comment[]
  teamMemberships TeamMember[]
  joinRequests    JoinRequest[]
  predictions     Prediction[]
  notifications   Notification[]

  @@map("users")
}

model Idea {
  id          String   @id @default(cuid())
  title       String
  description String
  tags        String[] @default([])
  category    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  votes       Vote[]
  investments Investment[]
  comments    Comment[]
  teamMembers  TeamMember[]
  joinRequests JoinRequest[]
  predictions  Prediction[]

  @@index([authorId])
  @@index([createdAt])
  @@map("ideas")
}

model Vote {
  id        String   @id @default(cuid())
  value     Int // 1 = upvote, -1 = downvote — enforced at the application layer
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  // One vote per user per idea. Also gives us the O(1) lookup the
  // create/update/toggle-off logic in POST /api/votes relies on.
  @@unique([userId, ideaId])
  // Composite (not just ideaId) so the Phase 8 analytics date-range scans
  // (WHERE ideaId = ? AND createdAt >= ?) hit the index directly — this
  // subsumes plain ideaId lookups too via the leftmost-prefix rule, so it
  // replaces rather than supplements the old single-column index.
  @@index([ideaId, createdAt])
  @@map("votes")
}

model Investment {
  id        String   @id @default(cuid())
  amount    Int // whole virtual credits, always > 0
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  // Deliberately NOT unique on [userId, ideaId] — a backer can invest more
  // than once as their conviction in an idea grows, and each investment
  // keeps its own timestamp for the "interest over time" analytics in
  // Phase 8. See README for the full rationale vs. a single-investment cap.
  @@index([ideaId, createdAt])
  @@index([userId])
  @@map("investments")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  author User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  // Self-relation for threaded replies. Deleting a comment cascades to its
  // replies rather than orphaning them under a dangling parentId.
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  Comment[] @relation("CommentReplies")

  @@index([ideaId, createdAt])
  @@index([parentId])
  @@map("comments")
}

enum TeamRole {
  FOUNDER
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TeamMember {
  id        String   @id @default(cuid())
  role      TeamRole
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  // Hard guarantee against "joining twice" — backstops the app-level check
  // the same way @@unique([userId, ideaId]) does for votes.
  @@unique([userId, ideaId])
  @@index([ideaId])
  @@map("team_members")
}

model JoinRequest {
  id        String             @id @default(cuid())
  status    JoinRequestStatus  @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  // A user has exactly one JoinRequest row per idea for its entire
  // lifetime — its *status* changes (PENDING → ACCEPTED/REJECTED), it isn't
  // replaced by a new row. This is what "cannot send multiple requests"
  // means here: the unique constraint makes duplicate requests impossible
  // at the DB level, while still allowing a user to re-apply after a
  // rejection by resetting the same row back to PENDING (see POST
  // /api/join-request). See README for the full rationale.
  @@unique([userId, ideaId])
  @@index([ideaId])
  @@map("join_requests")
}

model Prediction {
  id               String   @id @default(cuid())
  marketScore      Int // 1–10, how large is the addressable market
  feasibilityScore Int // 1–10, how buildable is this with reasonable resources
  riskScore        Int // 1–10, how risky — 10 = highest risk (see lib/scoring.ts for how this is inverted)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  ideaId String

  // One prediction per user per idea. Resubmitting updates this same row
  // (see POST /api/predict) rather than creating a new one — unlike
  // Investment, a prediction is a single current belief, not a
  // time-series of separate actions.
  @@unique([userId, ideaId])
  @@index([ideaId])
  @@map("predictions")
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  // Where clicking the notification should navigate, e.g. /ideas/{id}.
  // Nullable since not every notification necessarily points somewhere.
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Two indexes for the two access patterns: the bell's unread count
  // (userId + read) and the dropdown's recent list (userId + createdAt).
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}
